<?php
/** TEMPORARY: rename to setup.php to activate, then DELETE setup.php after success. */
declare(strict_types=1);
require dirname(__DIR__) . '/app/bootstrap.php';
if ($config['base_url'] === '' && preg_match('~^/(?:[A-Za-z0-9_-]+/)*public/setup\.php$~D', $_SERVER['SCRIPT_NAME'] ?? '')) {
    $config['base_url'] = dirname($_SERVER['SCRIPT_NAME']);
}
require dirname(__DIR__) . '/app/admin-security.php';
try { require dirname(__DIR__) . '/app/admin-setup.php'; }
catch (Throwable $error) { admin_failure($error); }
